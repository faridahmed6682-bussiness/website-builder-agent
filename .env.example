# Website Builder Agent — environment template
# Copy to .env and fill in. NEVER commit a real .env or any real key.

PORT=3000
NODE_ENV=development

# --- LLM router (PRIMARY LLM backend, free-only) ---
# MERGE (2026-11-27): the FreeLLMAPI-compatible router is EMBEDDED in this
# service (server/router/, same port) — NO separate FreeLLMAPI deploy needed.
# FREE_LLM_API_URL / FREE_LLM_API_KEY are OPTIONAL overrides for an external
# FreeLLMAPI; leave them unset to use the embedded router.
# FREE_LLM_API_URL=http://localhost:3001/v1
# FREE_LLM_API_KEY=your-freellmapi-key-here
# ROUTER_API_KEY: protects the embedded router's /v1 endpoint for outside
# callers. Optional — when unset, a random key is generated at boot (in
# memory only); the agent itself uses it internally. Set it if you want to
# call this service's /v1 API from another tool.
ROUTER_API_KEY=
# FREE_LLM_API_MODEL: router model — auto:balanced (default), auto:fast,
# auto:smart, auto:reliable, auto:cheap, auto:<profile>, or an explicit id.
FREE_LLM_API_MODEL=auto:balanced
# FREE_LLM_API_IMAGE_MODEL: image model for the generate_image tool.
FREE_LLM_API_IMAGE_MODEL=auto

# --- Optional fallback: direct Gemini key (free tier) ---
# Only used if FreeLLMAPI has no key configured. Leave empty for
# FreeLLMAPI-only operation.
GEMINI_API_KEY=

# GEMINI_API_KEYS: MANY Gemini keys, comma-separated — one key per Google
# Cloud project (the user has 10, each from its own account). Quotas are PER
# PROJECT, not per key: keys from different projects each carry their own
# Hydrogen quota, so 10 keys multiply capacity; keys from ONE project share
# one cap. Rotation is round-robin with per-key cooldown on 429; one key's
# limit ends → next key, SAME model, zero quality loss. The user enters them
# himself (FreeLLMAPI dashboard Keys page or here); NEVER ask for key values
# in chat, never commit them, never print them.
GEMINI_API_KEYS=

# GROQ_API_KEYS: Groq Cloud keys, comma-separated (the user has 11). Groq
# free caps are PER ORGANIZATION, not per key — keys in one org share one
# allowance (30 RPM / 1,000 RPD per chat model), so rotation adds
# availability, not multiplied quota. Free chat models (27 Nov 2026):
# openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b.
GROQ_API_KEYS=
# GROQ_API_KEY: legacy single-key form, merged into the list if not listed.
GROQ_API_KEY=

# OPENROUTER_API_KEYS: OpenRouter keys, comma-separated (the user has 8).
# OpenRouter free is 50 requests/day TOTAL across free models (20 RPM,
# shared pool) — extra keys add availability, not quota. Free models are
# live-discovered from GET /v1/models (:free) at boot + daily; today's
# leaders (27 Nov 2026): Nemotron 3, Gemma 4, Particle-1.
OPENROUTER_API_KEYS=
# OPENROUTER_API_KEY: legacy single-key form, merged into the list if not listed.
OPENROUTER_API_KEY=

# Per-task model chains (optional, comma-separated; IDs are verified live
# against the router catalog — unknown IDs are dropped, never assumed).
# CODING = Tier-2 chain (planning/coding/review — Hydrogen first).
FREE_LLM_API_MODEL_CODING=
# PLANNING = planning chain (Hydrogen xhigh for hard plans, R1 alternative).
FREE_LLM_API_MODEL_PLANNING=
# CHAT = general chat chain (fast models).
FREE_LLM_API_MODEL_CHAT=
# CHEAP = Tier-1 tool-loop chain (Flash-Lite / auto:fast — saves Hydrogen).
FREE_LLM_API_MODEL_CHEAP=
# FREE_LLM_API_ROUTING=off disables per-task routing (uses the configured model).

# --- Firebase one-click (optional) ---
# FIREBASE_CONFIG_ENCRYPTION_KEY: 64 hex chars (or base64 32 bytes) for the
# encrypted Firebase config store. Optional — when unset, a machine-local key
# is generated once in data/ (0600). The Firebase config itself is pasted
# once in the UI (Connect Firebase) — never here.
FIREBASE_CONFIG_ENCRYPTION_KEY=
# FIREBASE_TOKEN: one-time `npx firebase-tools login:ci` output; only needed
# for Deploy to Firebase Hosting from the UI. Leave empty otherwise.
FIREBASE_TOKEN=
FREE_LLM_API_ROUTING=

# --- GitHub one-click connect + push (no secrets in code) ---
# GITHUB_TOKEN: Personal Access Token (fine-grained, repo scope) — fallback
# when no OAuth App is configured. The user pastes it once in the UI.
GITHUB_TOKEN=
# GitHub OAuth App (one-time setup, free, no card): Client ID + Secret.
# Callback URL: <APP_URL>/api/github/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Key that encrypts the stored GitHub token (AES-256-GCM). If unset, a
# machine-local key is generated once in data/github-enc-key (0600).
GITHUB_TOKEN_ENCRYPTION_KEY=

# --- One-click deploy (Render) ---
# RENDER_DEPLOY_HOOK_URL: Deploy Hook URL from the Render service Settings
# (create the static site from the repo ONCE, then paste the hook here).
RENDER_DEPLOY_HOOK_URL=
# Optional: RENDER_API_KEY (+ RENDER_SERVICE_ID / RENDER_SERVICE_URL) for
# live deploy status + the live URL in the UI.
RENDER_API_KEY=
RENDER_SERVICE_ID=
RENDER_SERVICE_URL=

# --- Browser worker (Nexus's existing worker; env only) ---
BROWSER_WORKER_URL=
BROWSER_WORKER_KEY=
# Second worker (optional).
BROWSER_WORKER_URL2=

# --- Google APIs (Gmail/Calendar/Drive/Docs; OAuth refresh-token flow) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

APP_URL=
